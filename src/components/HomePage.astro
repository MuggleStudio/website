---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/site.shared.js';

const { name, email, githubUrl } = SITE_CONFIG;
const contactUrl = `mailto:${email}`;
const copyrightYear = new Date().getUTCFullYear();
---

<Layout
  title={name}
  description="MuggleStudio is an independent studio that designs and builds apps."
  canonicalPath="/"
>
  <div class="site">
    <header class="site-header">
      <div class="shell header-content">
        <a class="wordmark" href="/">
          <span class="studio-mark" aria-hidden="true"></span>
          {name}
        </a>
      </div>
    </header>

    <main class="hero">
      <div class="shell hero-content">
        <span class="star" aria-hidden="true">✦</span>
        <h1>We can't cast spells.<br />We build them.</h1>
        <p>We’re an independent studio that designs and builds apps.</p>
      </div>
    </main>

    <footer class="shell site-footer">
      <div class="copyright">
        <span class="studio-mark" aria-hidden="true"></span>
        <span>© {copyrightYear} {name}</span>
      </div>
      <div class="footer-links">
        <a class="footer-link" href={contactUrl} aria-label="Email MuggleStudio">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m4 7 8 6 8-6" />
          </svg>
        </a>
        <a class="footer-link" href={githubUrl} aria-label="MuggleStudio on GitHub">
          <img src="/media/github-mark.svg" width="18" height="18" alt="" />
        </a>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .site {
    --gutter: clamp(1.125rem, 6vw, 4.5rem);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .shell {
    width: min(calc(100% - 2 * var(--gutter)), 72rem);
    margin-inline: auto;
  }

  .site-header { border-bottom: 1px solid var(--rule); }

  .header-content {
    min-height: 4.25rem;
    display: flex;
    align-items: center;
  }

  .site a { text-decoration-line: none; }
  .site a:hover { text-decoration-line: underline; }

  .wordmark {
    gap: .5rem;
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -.035em;
  }

  .studio-mark {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    background: currentColor;
    mask: url("/favicon.svg") center / contain no-repeat;
  }

  .header-content a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    white-space: nowrap;
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    flex: 1;
    display: grid;
    align-items: center;
    text-align: center;
    background: radial-gradient(ellipse 60% 88% at 50% 0%, #352747 0%, transparent 78%);
  }

  .hero::before, .hero::after {
    content: "";
    position: absolute;
    width: min(85%, 41rem);
    height: 23rem;
    top: -17.5rem;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero::before {
    z-index: -2;
    border: 1px solid #ac91d66b;
    box-shadow: 0 0 1.625rem #a285e330;
  }

  .hero::after { content: none; }

  .hero-content {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 2.4vw, 1.5rem);
    padding-block: clamp(2rem, 8svh, 6rem);
  }

  .star {
    color: var(--accent);
    font-size: 1.55rem;
    line-height: 1;
  }

  h1 {
    font-size: clamp(2.1rem, 6.6vw, 5.65rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -.045em;
    word-spacing: .035em;
  }

  .hero p, .copyright { color: var(--muted); }

  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .75rem;
    border-top: 1px solid var(--rule);
    padding-block: .625rem;
  }

  .footer-links {
    display: flex;
    gap: .625rem;
  }

  .footer-link {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--rule);
    border-radius: .5rem;
  }

  .copyright {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .75rem;
  }

  .copyright .studio-mark {
    width: 1.25rem;
    height: 1.25rem;
  }

  .footer-link img { object-fit: contain; }

  .footer-link:hover, .footer-link:focus-visible { background: #241b2d; }

  @media (prefers-reduced-motion: no-preference) {
    .hero::after {
      content: "";
      z-index: -1;
      border: 2px solid #e1ccff;
      box-shadow: inset 0 0 .9375rem #ab76ed;
      mask: linear-gradient(90deg, transparent, #000 48%, transparent) no-repeat -50% 0 / 28% 100%;
      opacity: 0;
      animation: arc-sweep 14s linear infinite;
    }

    @keyframes arc-sweep {
      0% { mask-position: -50% 0; opacity: 0; }
      5%, 22% { opacity: 1; }
      27%, 100% { mask-position: 150% 0; opacity: 0; }
    }
  }

  @media (max-width: 37rem) {
    .site { --gutter: clamp(1.125rem, 5.2vw, 1.75rem); }
    .header-content { min-height: 3.625rem; }
    .hero::before, .hero::after { top: -19.75rem; }

    h1 {
      font-size: clamp(2rem, 8.65vw, 3.15rem);
      line-height: 1.06;
    }

    .hero p {
      max-width: 26ch;
      font-size: .9375rem;
      line-height: 1.5;
      text-wrap: balance;
    }
  }
</style>
