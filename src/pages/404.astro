---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/site.shared.js';
---

<Layout title={`Page not found | ${SITE_CONFIG.name}`}>
  <main>
    <h1>Page not found</h1>
    <a href="/">Back to home</a>
  </main>
</Layout>

<style>
  main {
    min-height: 100svh;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: .5rem;
    padding: 1.5rem;
    text-align: center;
    background: radial-gradient(ellipse at 50% 0%, #352747, transparent 65%);
  }

  h1 { font-size: clamp(2rem, 7vw, 4rem); font-weight: 500; letter-spacing: -.05em; }
  a { display: inline-flex; align-items: center; min-height: 2.75rem; }
</style>
